ENVIRONMENT=production
DJANGO_SETTINGS_MODULE=config.settings.prod
DEBUG=false
SECRET_KEY=REQUIRED_FROM_VAULT_HIGH_ENTROPY_STRING

ALLOWED_HOSTS=erp.complect.ru
CORS_ALLOWED_ORIGINS=https://complect.ru
CSRF_TRUSTED_ORIGINS=https://complect.ru
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_PROXY_SSL_HEADER=true
USE_X_FORWARDED_HOST=true
X_FRAME_OPTIONS=DENY
SESSION_COOKIE_HTTPONLY=true
CSRF_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

DJANGO_ALLOW_ASYNC_UNSAFE=false

TIME_ZONE=Europe/Moscow
LANGUAGE_CODE=ru-ru

DATABASE_URL=postgresql://complect_admin:PASSWORD@postgres_primary:5432/complect_db
DATABASE_REPLICA_URL=postgresql://complect_admin:PASSWORD@postgres_replica:5432/complect_db

ENABLE_RLS=true
RLS_NAMESPACE=app.current_tenant_id
POSTGRES_REPLICA_ENABLED=true
POSTGRES_REPLICA_MAX_LAG=1.0

REDIS_DEFAULT_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
REDIS_CELERY_URL=redis://redis:6379/2
REDIS_STREAMS_URL=redis://redis:6379/3
REDIS_IDEMPOTENCY_URL=redis://redis:6379/4
CHANNEL_LAYER_URL=redis://redis:6379/5
CELERY_RESULT_BACKEND=redis://redis:6379/6
REDIS_AUDIT_URL=redis://redis:6379/7

EVENT_BUS_BACKEND=redis
AUDIT_RETENTION_DAYS=3650
DLQ_RETENTION_DAYS=30
LOG_RETENTION_DAYS=90

PLATFORM_READONLY_MODE=false
ENABLE_PUBLIC_API=true
ENABLE_REALTIME=true
ENABLE_FINANCE_EXPORTS=true
ENABLE_ANALYTICS=true

EXPECTED_GATEWAY_TOKEN=REQUIRED_CRYPTO_SIGNATURE_FROM_VAULT
INTERNAL_SERVICE_TOKEN=REQUIRED_CRYPTO_SIGNATURE_FROM_VAULT
TRUSTED_SERVICE_NETWORK=10.0.0.0/8
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_PROCESSING_TTL_SECONDS=60
MAX_UPLOAD_SIZE_MB=50
DATA_UPLOAD_MAX_MEMORY_SIZE=52428800
FILE_UPLOAD_MAX_MEMORY_SIZE=52428800
DLQ_STREAM_NAME=infrastructure:dlq:stream
FEATURE_FLAGS_PREFIX=flags:
PUBLIC_URL_PREFIXES=/public/,/health/,/metrics/

CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_ACKS_LATE=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_MAX_RETRIES=5
CELERY_TASK_RETRY_BACKOFF=true
CELERY_TASK_RETRY_JITTER=true

LOG_LEVEL=INFO
STRUCTLOG_JSON=true
ENABLE_OTEL=true
OTEL_SERVICE_NAME=complect-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel_collector:4317

CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=120
AWS_DEFAULT_REGION=ru-central-1
S3_ENDPOINT_URL=https://internal.net
S3_ACCESS_KEY_ID=REQUIRED
S3_SECRET_ACCESS_KEY=REQUIRED
S3_QUARANTINE_BUCKET=complect-quarantine
S3_PRODUCTION_BUCKET=complect-production
AUDIT_GENESIS_SALT=REQUIRED_HIGH_ENTROPY_SALT_FROM_VAULT

LIVEKIT_URL=https://complect.ru
LIVEKIT_API_KEY=REQUIRED
LIVEKIT_API_SECRET=REQUIRED


