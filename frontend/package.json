{
  "name": "complect-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript http://localhost:8000/api/v1/openapi.json -o src/shared/api/generated/schema.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cd e2e && PLAYWRIGHT_BROWSERS_PATH=/home/sever/.cache/ms-playwright npx playwright test",
    "test:e2e:ui": "cd e2e && PLAYWRIGHT_BROWSERS_PATH=/home/sever/.cache/ms-playwright npx playwright test --headed"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@tanstack/react-query": "^5.77.0",
    "@tanstack/react-query-devtools": "^5.77.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "jwt-decode": "^4.0.0",
    "next": "15.3.2",
    "openapi-fetch": "^0.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.56.0",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.3.2",
    "openapi-typescript": "^7.8.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
