# Public local development configuration. Bootstrap replaces the three tokens.
# Secrets live separately in ignored .dev/secrets; external keys in .dev/external.env.
COMPOSE_PROJECT_NAME=__PROJECT__
DEV_UID=__UID__
DEV_GID=__GID__
DEV_FRONTEND_ORIGIN=http://localhost:8080
DEV_API_ORIGIN=http://localhost:8000
IAM_DEFERRED_MERGE_EXECUTION_ENABLED=false
