# Public local development configuration. Bootstrap replaces the three tokens.
# Secrets live separately in ignored .dev/secrets; external keys in .dev/external.env.
COMPOSE_PROJECT_NAME=__PROJECT__
DEV_UID=__UID__
DEV_GID=__GID__
DEV_FRONTEND_ORIGIN=http://localhost:8080
DEV_API_ORIGIN=http://localhost:8000
IAM_DEFERRED_MERGE_EXECUTION_ENABLED=false
# COMPLECT_DOCKER_SUBNET is selected per checkout from 198.18.16.0/20.
# Leave it absent for a new checkout: the helper selects an ephemeral candidate,
# creates the exact project network, then atomically persists the candidate here.
# The following comment is the provenance marker for that persisted auto value:
# COMPLECT_DOCKER_SUBNET=198.18.<checkout-slot>.0/24
# COMPLECT_AUTO_SUBNET=198.18.<checkout-slot>.0/24
# An edited value without an equal COMPLECT_AUTO_SUBNET marker is explicit and
# is never changed automatically. Explicit values remain the host owner's
# responsibility for route/VPN compatibility and must pass overlap validation.
