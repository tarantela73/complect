ARG BASE_IMAGE=complect_backend:dev
FROM ${BASE_IMAGE}

ARG ACTIONLINT_VERSION=1.7.7
ARG ACTIONLINT_SHA256=023070a287cd8cccd71515fedc843f1985bf96c436b7effaecce67290e7e0757

RUN archive="/tmp/actionlint.tar.gz" \
    && curl --fail --location --retry 3 --output "$archive" \
       "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_linux_amd64.tar.gz" \
    && echo "${ACTIONLINT_SHA256}  ${archive}" | sha256sum --check --strict \
    && tar --extract --file "$archive" --directory /tmp actionlint \
    && install --mode 0755 /tmp/actionlint /usr/local/bin/actionlint \
    && rm -f "$archive" /tmp/actionlint

WORKDIR /workspace
ENV PYTHONPATH=/workspace:/workspace/backend
ENTRYPOINT ["python", "-m", "infra.scripts.run_infra_quality"]
