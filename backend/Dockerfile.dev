FROM python:3.12.13-slim@sha256:090ba77e2958f6af52a5341f788b50b032dd4ca28377d2893dcf1ecbdfdfe203 AS toolchain

RUN pip install --no-cache-dir --no-deps uv==0.11.21

FROM toolchain AS development

# Установка системных зависимостей для PostGIS и WeasyPrint (PDF rendering)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    netcat-openbsd \
    gdal-bin \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Копируем и кэшируем слои зависимостей
COPY requirements ./requirements
RUN python requirements/lock.py check \
    && uv pip install --system --require-hashes --no-deps -r requirements/dev.lock \
    && uv pip check --system

# Копируем исходный код бэкенда
COPY . .

# CMD по умолчанию переопределяется в docker-compose под запуск конкретного сервиса
